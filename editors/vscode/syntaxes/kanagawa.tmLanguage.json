{
  "$comment": "GENERATED by `cargo xtask codegen` from SyntaxKind. Do not edit.",
  "fileTypes": [
    "k"
  ],
  "name": "Kanagawa",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "attributes": {
      "patterns": [
        {
          "begin": "\\[\\[",
          "end": "\\]\\]",
          "name": "meta.attribute.kanagawa",
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_]*",
              "name": "entity.name.function.attribute.kanagawa"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "match": "//[|<].*$",
          "name": "comment.line.documentation.kanagawa"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.kanagawa"
        },
        {
          "begin": "/\\*[|<]",
          "end": "\\*/",
          "name": "comment.block.documentation.kanagawa"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.kanagawa",
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:break|case|default|do|else|for|if|return|switch|unrolled_for|while)\\b",
          "name": "keyword.control.kanagawa"
        },
        {
          "match": "\\b(?:false|true)\\b",
          "name": "constant.language.kanagawa"
        },
        {
          "match": "\\b(?:const|export|extern|inline|noinline|private|public|static)\\b",
          "name": "storage.modifier.kanagawa"
        },
        {
          "match": "\\b(?:static_assert|byteoffsetof|bitoffsetof|bytesizeof|bitsizeof|decltype|template|barrier|fan_out|reorder|atomic|concat|import|lutmul|module|struct|class|clog2|union|using|cast|enum|mux|as)\\b",
          "name": "keyword.other.kanagawa"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][-+]?[0-9]+)?|[eE][-+]?[0-9]+)",
          "name": "constant.numeric.float.kanagawa"
        },
        {
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*)(?:[iu][0-9]+)?",
          "name": "constant.numeric.integer.kanagawa"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?:\\|\\|=|&&=|\\^\\^=|<<|>>|<=|>=|==|!=|&&|\\|\\||\\^\\^|::|->|\\+\\+|--|[-+*/%&|^~!?:]=?|=)",
          "name": "keyword.operator.kanagawa"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.kanagawa",
          "patterns": [
            {
              "match": "\\\\(?:[0-9]+|x[0-9A-Fa-f]+|o[0-7]+|\\^[A-Z@\\[\\]\\\\^_]|[A-Za-z&\"'\\\\])",
              "name": "constant.character.escape.kanagawa"
            },
            {
              "match": "\\{\\{",
              "name": "constant.character.escape.kanagawa"
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "name": "meta.embedded.kanagawa",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(?:u?int)[0-9]+\\b",
          "name": "storage.type.kanagawa"
        },
        {
          "match": "\\b(?:auto|bool|float32|int|string|typename|uint|void)\\b",
          "name": "storage.type.kanagawa"
        }
      ]
    }
  },
  "scopeName": "source.kanagawa"
}
