+    /// `setTypeOfTemplateCall`'s stamp does not cross the read-back seam.
+    ///
+    /// The stamp is a deduction hint about one round's tree — a synthetic
+    /// `TFunction FreeFunction mempty t mempty` planted on a callee the round
+    /// could not resolve, so the expected type can flow backwards into it
+    /// (`Type.hs:1120-1129`, [`kg_ty::infer::TypeTable::stamp_template_call`]).
+    /// Its parameter list is empty whatever the callee's arity is.
+    ///
+    /// Pass 8's twin fails to resolve things the user's module resolves: here
+    /// `captureThis` rewrites `Helper(tid)` to `$this.Helper(tid)` and the twin
+    /// spells the receiver `__kg_mN.Helper` on a capture whose type is a
+    /// `decltype` declared inside `run`, which nothing at the twin's file scope
+    /// can link. So the twin stamps `Helper` — and the read-back carried the
+    /// stamp home onto the *written* callee's key, where this pass read it as a
+    /// nullary free function and reported "Invalid number of arguments,
+    /// expected 0" about a program the reference compiles.
+    ///
+    /// Red with the stamp skip cut from `kg_hir::readback::read_back`. What it
+    /// does not see: that the stamp still reaches deduction inside the twin —
+    /// that is `conformance`'s (`template-argument-deduction.k::7,8,10,15`).
+    #[test]
+    fn a_template_calls_stamp_does_not_cross_the_read_back_seam() {
+        let text = "template <typename I>\ninline void Go(auto count, (I) -> void body)\n{\n}\n\n\
+            class C\n{\nprivate:\nnoinline uint32 Helper(uint32 x)\n{\nreturn x + 1;\n}\npublic:\n\
+            void run(uint32 tag)\n{\nGo(1024, [tag](uint32 tid)\n{\nuint32 result = Helper(tid);\n});\n}\n}\n\n\
+            export C;\n";
+        let reports: Vec<String> = crate::tests::program(&[("main.k", text)])
+            .into_iter()
+            .map(|(m, at, _)| format!("{m} @ {at}"))
+            .collect();
+        assert_eq!(reports, Vec::<String>::new());
+    }
 }
