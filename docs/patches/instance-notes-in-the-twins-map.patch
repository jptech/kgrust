+    /// `setTypeOf`'s `TInstance` threading (`Type.hs:1050-1058`) applied to a
+    /// twin's finished map: where `notes` has `setTypeOfInstance`'s note for a
+    /// key this map resolved, the resolved type becomes the note's concrete
+    /// half.
+    ///
+    /// The reference writes the note *before* `inferType`, so the concrete
+    /// type is threaded into the wrapper as it is computed and every reader
+    /// sees a `TInstance`. This route infers the twin first — the twin is a
+    /// file, and a file is inferred whole — so the threading happens here
+    /// instead. Without it a copy is a plain struct named after itself:
+    /// `using tag_t = newtype<uint32>` came home as `type.newtype::newtype
+    /// <|$uint@32|>` where the reference prints `newtype<uint32>`
+    /// (`Type.hs:402-406` prints a `TInstance` from its arguments), which
+    /// `xtask ir`'s type-agreement line reads as a disagreement and the
+    /// backend walk reads as a copy with no instance note.
+    pub(crate) fn thread_instances(&self, notes: &FxHashMap<SymbolPath, Ty>) -> ModuleTypes {
+        if notes.is_empty() {
+            return self.clone();
+        }
+        let mut names: FxHashMap<SymbolPath, Ty> = (*self.names).clone();
+        for (key, note) in notes {
+            let Ty::Instance { template, args, .. } = note else { continue };
+            let Some(Ty::Type(inner)) = names.get(key) else { continue };
+            // Only an aggregate. The reference's `TInstance` is transparent to
+            // every predicate that matters for a scalar — `pretty` falls
+            // through for a function, an error and an unresolved inner
+            // (`Type.hs:402-405`) — but this port's `Ty::Instance` is not, and
+            // wrapping an alias template's `using U = uint32` copy made the
+            // backend walk emit a base list where the reference emits
+            // `ParseUintType 32` (145 programs, measured 2026-09-20). The
+            // aggregates are where the note is read anyway: `ParseClass`'s
+            // third argument is `parseInstanceType (theType expr)`.
+            if !inner.resolved()
+                || !matches!(
+                    &**inner,
+                    Ty::Struct(..) | Ty::Class(..) | Ty::Union(..) | Ty::Enum(..)
+                )
+            {
+                continue;
+            }
+            let threaded = Ty::Type(kg_ty::TyRef::new(Ty::Instance {
+                concrete: inner.clone(),
+                template: template.clone(),
+                args: args.clone(),
+            }));
+            names.insert(key.clone(), threaded);
+        }
+        ModuleTypes { names: Arc::new(names) }
+    }
