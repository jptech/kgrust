+/// `setTypeOfInstance`'s notes, keyed the way a twin's [`ModuleTypes`] keys
+/// the copies they are about.
+///
+/// The writes come back from `instantiate` keyed on the *arena* — file, range,
+/// kind and expansion — because that is what the read-back needs. A module's
+/// finished map is keyed by qualified name, so each write is matched back to
+/// the declaration it was made for and re-keyed under the name the twin gives
+/// it. Top-level declarations only: `Template.hs:115` puts every copy beside
+/// its template, and a nested one would need the twin's own scope walk.
+fn instance_notes(
+    renamed: &ModuleIr,
+    writes: &[(kg_ty::infer::TypeKey, kg_ty::Ty)],
+    scope: &SymbolPath,
+) -> FxHashMap<SymbolPath, kg_ty::Ty> {
+    let mut out = FxHashMap::default();
+    if writes.is_empty() {
+        return out;
+    }
+    let by_key: FxHashMap<kg_ty::infer::TypeKey, &kg_ty::Ty> =
+        writes.iter().map(|(k, t)| (*k, t)).collect();
+    for item in top_level_items(renamed) {
+        let name = match &renamed.arena[item].exp {
+            Exp::Class { name, .. }
+            | Exp::Struct { name, .. }
+            | Exp::Union { name, .. }
+            | Exp::Enum { name, .. }
+            | Exp::Alias { name, .. }
+            | Exp::Function { name, .. } => *name,
+            _ => continue,
+        };
+        let Exp::Identifier(sym) = renamed.arena[name].exp else { continue };
+        let node = &renamed.arena[item];
+        let range = node.src.head.range;
+        let key = kg_ty::infer::TypeKey {
+            file: node.src.head.file,
+            offset: range.start(),
+            end: range.end(),
+            kind: node.kind,
+            via: node.src.via,
+        };
+        if let Some(ty) = by_key.get(&key) {
+            out.insert(scope.child(sym), (*ty).clone());
+        }
+    }
+    out
+}
